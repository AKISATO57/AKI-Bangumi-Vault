{
  "name": "bangumi-vault",
  "version": "1.1.0",
  "description": "Bangumi 保管库：本地优先的 Bangumi 收藏备份桌面应用。",
  "main": "main.js",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check main.js && node --check preload.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "source:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1"
  },
  "author": "AKISATO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AKISATO57/AKI-Bangumi-Vault.git"
  },
  "homepage": "https://akibangumibackup.netlify.app",
  "bugs": {
    "url": "https://github.com/AKISATO57/AKI-Bangumi-Vault/issues"
  },
  "devDependencies": {
    "electron": "39.8.10",
    "electron-builder": "26.15.7",
    "linkedom": "0.18.12"
  },
  "build": {
    "appId": "io.github.akisato.bangumi.vault",
    "productName": "Bangumi 保管库",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "lib/**/*",
      "scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": "app"
      },
      {
        "from": "build",
        "to": "build"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  }
}
